# Your domain pointing to this server (e.g. bill.yourdomain.com)
DOMAIN=bill.yourdomain.com

# Full public URL of the app — used for absolute OG image URLs (WhatsApp previews)
# If omitted, falls back to https://$DOMAIN
NEXT_PUBLIC_APP_URL=https://bill.yourdomain.com

# Docker network name of your existing Caddy stack (so Caddy can reach this app)
# Find it with: docker network ls | grep caddy
CADDY_NETWORK=ccstudios-stack_default

# Supabase — baked into the build, must be set before 'docker compose up --build'
NEXT_PUBLIC_SUPABASE_URL=https://qcyhcbwlnydhmcwsezod.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6InFjeWhjYndsbnlkaG1jd3Nlem9kIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NzkzMDYxNDUsImV4cCI6MjA5NDg4MjE0NX0.Wnl9-Bw1bdw70jUoBAZLmwB4iFS7Vp8pKhwc1IO4JSE

# OCR API keys — at least one is needed for bill parsing
# Users can also enter their own keys in the UI settings modal
ANTHROPIC_API_KEY=sk-ant-...
GOOGLE_API_KEY=AIzaSy...
OPENAI_API_KEY=sk-proj-...

# Secret token for the cleanup endpoint (generate with: openssl rand -hex 32)
CLEANUP_SECRET=changeme
